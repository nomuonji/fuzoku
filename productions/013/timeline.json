 "subs": [
  [
   0.18,
   4.04,
   "左の耳から、\nラジオの女の人の声が、\n消えた。"
  ],
  [
   4.34,
   10.229,
   "火曜の二十二時十八分。\n帰りの電車で、俺は、\n深夜のラジオを聴いている。"
  ],
  [
   10.389,
   16.981,
   "二年二か月前に、\n一万四千八百円で買ったイヤホン。\nその左の電池が、切れた。"
  ],
  [
   17.101,
   19.059,
   "電池は、使うほど弱る。"
  ],
  [
   19.179,
   22.72,
   "ただ、このイヤホンの電池は、\n客には替えられない。"
  ],
  [
   22.84,
   30.051,
   "メーカーに送れば、\n電池の交換は八千二百円。\n新品は、一万四千八百円だ。"
  ],
  [
   30.171,
   36.212,
   "その値段なら、\n新品を買う人が多い。\n値段を決める人も、\nそれは分かっている。"
  ],
  [
   36.332,
   40.187,
   "引き出しには、\n電池の切れたイヤホンが、\nもう二つある。"
  ],
  [
   40.307,
   46.456,
   "うちの会社の製品も同じだ。\n先月、その仕様の確認欄に、\n俺が判を押した。"
  ],
  [
   46.676,
   51.395,
   "物が壊れる日は、\n次の売上の日として、\nはじめから予定に入っている。"
  ],
  [
   51.745,
   56.622,
   "俺はその予定の中で、\n給料をもらって、\n予定どおりに買っている。"
  ],
  [
   56.742,
   62.617,
   "右の耳には、まだ低い声が残っている。\n耳のすぐそばで、\n息をするような声だ。"
  ],
  [
   62.737,
   66.285,
   "電池を替えられれば、\n声は、左にも戻ってくる。"
  ],
  [
   66.405,
   70.253,
   "替えられないから、\n新品が届くまで、左は静かだ。"
  ],
  [
   70.373,
   76.333,
   "隣に女の人が立った。\n吊り革を握る手の隣から、\n石けんの匂いが、した。"
  ],
  [
   76.453,
   80.811,
   "電池も、新品も要らない体温が、\n俺の手の隣にあった。"
  ]
 ],
