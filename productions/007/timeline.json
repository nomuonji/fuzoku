 "subs": [
  [
   0.18,
   4.276,
   "スマホをやめる方法の動画は、\n五秒の広告から始まった。"
  ],
  [
   6.006,
   12.372,
   "二十三時三十二分。\n俺は帰りの電車で、\n「スマホをやめる方法」\nという動画を見ている。"
  ],
  [
   12.692,
   16.162,
   "さっき、スマホの\n使用時間の通知が\n来たからだ。"
  ],
  [
   16.422,
   22.537,
   "一日平均、五時間四十八分。\n先週より、\n十二パーセント増えていた。"
  ],
  [
   22.797,
   27.109,
   "動画は十二分。\n始まる前に、\n五秒の広告が流れた。"
  ],
  [
   27.369,
   30.405,
   "俺は一・五倍速にして、\n最後まで見た。"
  ],
  [
   30.665,
   37.354,
   "終わると、次の動画が\n勝手に始まった。\n「寝る前のスマホをやめる、\nたった一つの習慣」。"
  ],
  [
   37.614,
   39.602,
   "それも、最後まで見た。"
  ],
  [
   39.862,
   44.683,
   "この動画アプリは、\n無料で見られる。\nその代わりに、広告が流れる。"
  ],
  [
   44.943,
   50.147,
   "客が長く見るほど\n広告が多く流れて、\nアプリと動画を作った人に\n金が入る。"
  ],
  [
   50.407,
   54.807,
   "だからアプリは、\n客が長く見る動画を、\n次から次へと出してくる。"
  ],
  [
   55.067,
   59.32,
   "スマホをやめたい人は多いから、\nやめる方法の動画も\nよく見られる。"
  ],
  [
   59.58,
   63.84,
   "俺がやめる方法を\n見ている間も、広告は\n同じように流れている。"
  ],
  [
   64.16,
   68.378,
   "スマホをやめる方法を\n見ている時間も、\nアプリの売上になっている。"
  ],
  [
   69.018,
   73.425,
   "電車を降りた。\n今日いちばん長く\n触っていたのは、この画面だ。"
  ],
  [
   73.685,
   76.603,
   "指先に、まだ\n画面の熱が残っている。"
  ],
  [
   76.993,
   80.61,
   "改札を出ると、\n知らない女の香水の\n匂いがした。"
  ]
 ],
