 "subs": [
  [
   0.45,
   3.187,
   "次は、わざと\n間違えようかと思った。"
  ],
  [
   4.737,
   9.387,
   "二十三時十四分。有人レジには、\nもう鎖が掛かっている。"
  ],
  [
   9.587,
   14.595,
   "レモンサワーのロング缶と、\n二割引きの上から半額を\n重ね貼りされた焼き鳥。"
  ],
  [
   14.795,
   17.447,
   "シールが貼られる時間は、\n知っている。"
  ],
  [
   17.647,
   21.82,
   "昔は、釣り銭と一緒に、\n指先が一瞬だけ触れた。"
  ],
  [
   22.02,
   25.466,
   "それだけで、\n一日でいちばん人肌に近かった。"
  ],
  [
   26.666,
   32.916,
   "ランプが点くと、\n夜勤の女が小走りで来る。\n俺の手の横を、\n細い指が通り過ぎる。"
  ],
  [
   33.116,
   36.967,
   "「大丈夫ですよ」。三秒で、\n彼女は戻っていった。"
  ],
  [
   37.167,
   39.904,
   "次は、\nわざと間違えようかと思った。"
  ],
  [
   40.154,
   42.465,
   "手間が省けた、と世の中は言う。"
  ],
  [
   42.515,
   45.659,
   "省かれたのは、手間じゃない。\n手だ。"
  ],
  [
   46.159,
   51.029,
   "自動ドアが開く。雨の匂いに、\n知らない女の香水が混じった。"
  ]
 ],
