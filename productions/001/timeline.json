 "subs": [
  [
   0.45,
   3.187,
   "次は、わざと\n間違えようかと思った。"
  ],
  [
   5.137,
   9.787,
   "二十三時十四分。有人レジには、\nもう鎖が掛かっている。"
  ],
  [
   9.987,
   14.995,
   "レモンサワーのロング缶と、\n二割引きの上から半額を\n重ね貼りされた焼き鳥。"
  ],
  [
   15.195,
   17.847,
   "シールが貼られる時間は、\n知っている。"
  ],
  [
   18.047,
   22.22,
   "昔は、釣り銭と一緒に、\n指先が一瞬だけ触れた。"
  ],
  [
   22.42,
   25.866,
   "それだけで、\n一日でいちばん人肌に近かった。"
  ],
  [
   27.066,
   33.316,
   "ランプが点くと、\n夜勤の女が小走りで来る。\n俺の手の横を、\n細い指が通り過ぎる。"
  ],
  [
   33.516,
   37.367,
   "「大丈夫ですよ」。三秒で、\n彼女は戻っていった。"
  ],
  [
   37.567,
   40.304,
   "次は、\nわざと間違えようかと思った。"
  ],
  [
   40.554,
   42.865,
   "手間が省けた、と世の中は言う。"
  ],
  [
   42.915,
   46.059,
   "省かれたのは、手間じゃない。\n手だ。"
  ],
  [
   46.559,
   51.429,
   "自動ドアが開く。雨の匂いに、\n知らない女の香水が混じった。"
  ]
 ],
