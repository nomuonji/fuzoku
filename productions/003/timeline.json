  ],
  [
   21.215,
   25.599,
   "七百三十七円。\n玄関には、\n同じのが六本ある。"
  ],
  [
   25.799,
   31.895,
   "レジの奥に、\n忘れ物の傘が束ねてある。\nたぶん、一本は俺のだ。"
  ],
  [
   32.145,
