   4.532,
   "テープを剥がすと、\n新しいビニールが、\n指に吸いついた。"
  ],
  [
   6.682,
   10.462,
   "二十三時八分。\n改札を出たら、\n降っていた。"
  ],
  [
   10.662,
   15.382,
