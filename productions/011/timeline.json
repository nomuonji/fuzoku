 "subs": [
  [
   0.18,
   4.187,
   "まだ使える椅子を、\n四十二脚、\n買い替えることになった。"
  ],
  [
   4.487,
   10.652,
   "水曜の十七時四十分。\n会社の会議室だ。\n俺は、部の予算を管理している。"
  ],
  [
   10.832,
   17.55,
   "課長が言った。\n「下期の予算が、あと\n百十一万七千円ある。\n十二月までに使い切ってくれ」"
  ],
  [
   17.73,
   25.417,
   "いまの椅子は、去年買ったばかりで、\n壊れていない。\n新しい椅子は、\n一脚、二万六千六百円だ。"
  ],
  [
   25.597,
   30.279,
   "それでも買うのは、\n使い切らないと、残りを\n会社に返すことになるからだ。"
  ],
  [
   30.459,
   35.021,
   "返すと、来年のうちの部の予算は、\n返した分だけ減らされる。"
  ],
  [
   35.201,
   40.299,
   "だから、先に金額が決まっていて、\n買う物は、あとから\n探すことになる。"
  ],
  [
   40.479,
   45.276,
   "俺は、余りそうな月は、\n買う物の候補を、\n先にメモしておく。"
  ],
  [
   45.456,
   54.871,
   "買う物が決まったら、\n俺が稟議書を書く。購入理由は、\n「座面の劣化により、業務効率に\n影響が出ているため」だ。"
  ],
  [
   55.051,
   58.953,
   "古い椅子は、お金を払って、\n業者に引き取ってもらう。"
  ],
  [
   59.213,
   62.905,
   "俺の仕事は、\nいらない物が要る理由を、\n書くことだ。"
  ],
  [
   63.275,
   66.633,
   "課長は、理由の欄を\n読まずに、判を押した。"
  ],
  [
   66.813,
   70.688,
   "赤い判の跡は、紙の上で、\nまだ少し濡れていた。"
  ],
  [
   70.868,
   77.39,
   "稟議書を総務に出すと、\n受け取った女の人の指先が、\n一秒だけ、俺の指に触れた。"
  ],
  [
   77.57,
   78.96,
   "あたたかい指だった。"
  ],
  [
