 "subs": [
  [
   0.35,
   3.534,
   "冷たい瓶のラベルに、\n滋養強壮と\n書いてある。"
  ],
  [
   5.734,
   10.569,
   "二十二時五十一分。\n駅前のドラッグストアは、\nあと九分で閉まる。"
  ],
  [
   10.739,
   13.718,
   "天井から、\n閉店の放送が\n流れている。"
  ],
  [
   13.888,
   19.922,
   "レジの横の冷蔵ケースから、\n栄養ドリンクを一本取る。\n四百九十八円だ。"
  ],
  [
   20.092,
   23.131,
   "明日の朝、\n会社に入る前に\n飲む分だ。"
  ],
  [
   23.301,
   28.077,
   "ケースの瓶は、\n百五十八円から、\n九百八十円まである。"
  ],
  [
   28.247,
   33.12,
   "俺は、疲れ具合で\n値段を選ぶ。\n今夜は、上から二番目だ。"
  ],
  [
   33.34,
   36.524,
   "冷たい瓶のラベルに、\n滋養強壮と\n書いてある。"
  ],
  [
   36.694,
   40.839,
   "「ポイントカードは\nお持ちですか」。\n俺は、アプリの\nバーコードを出す。"
  ],
  [
   41.159,
   46.987,
   "これを飲んでも、\n疲れが消えるわけではない。\n明日の夕方まで、\n体がもつだけだ。"
  ],
  [
   47.157,
   52.469,
   "体がもつから、\nまた働ける。\n働くから、また疲れて、\nこの店に来る。"
  ],
  [
   52.639,
   58.152,
   "店も、それを分かっている。\nだから、このケースは、\nレジのすぐ横にある。"
  ],
  [
   58.322,
   62.699,
   "会社は、\nこの四百九十八円を、\n一円も出さない。"
  ],
  [
   62.869,
   66.29,
   "平日に毎晩買えば、\nひと月で\n一万円を超える。"
  ],
  [
   66.66,
   71.27,
   "俺は、\n会社のために働く元気を、\n自分の給料で買っている。"
  ],
  [
   71.77,
   75.679,
   "外に出ると、\nレジ袋の中で、\n瓶がひとつだけ冷たい。"
  ],
  [
   75.849,
   79.36,
   "この元気を使うのは、\n明日の朝九時からの\n会社だ。"
  ]
 ],
 "teaser_end": 3.784
