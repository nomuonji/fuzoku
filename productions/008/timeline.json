 "subs": [
  [
   0.18,
   3.784,
   "四分で終わった仕事の後に、\n次の仕事が届いた。"
  ],
  [
   5.364,
   12.748,
   "十九時五十八分。\n会社の席で、月末の\n売上集計を終えた。\nかかった時間は、四分だ。"
  ],
  [
   13.048,
   18.406,
   "以前は二時間四十分かかった。\n残業中に、\n自分でマクロを組んだ。"
  ],
  [
   18.586,
   22.591,
   "今日は早く帰れる。\nネクタイを緩めて、\n椅子にもたれた。"
  ],
  [
   22.771,
   29.216,
   "課長からチャットが来た。\n「早いね。ついでに、\n先月との比較表を、\n明日の朝までに」。"
  ],
  [
   29.396,
   33.928,
   "その表は毎月作っているが、\n読む人を、\n俺は見たことがない。"
  ],
  [
   34.108,
   39.026,
   "俺は「承知しました」と返した。\n比較表には、二時間かかった。"
  ],
  [
   39.206,
   44.492,
   "会社を出たのは、二十二時二分。\n帰る時間は、\nいつもと同じだった。"
  ],
  [
   44.672,
   49.593,
   "会社は、一人が一日に\nこなせる量を見て、\n人数と給料を決めている。"
  ],
  [
   49.773,
   54.512,
   "俺が速くなると、\n同じ給料のまま、\nこなせる量が増えたことになる。"
  ],
  [
   54.692,
   60.618,
   "空いた時間は、俺のものにはならない。\n次の仕事を入れていい時間として、\n数えられる。"
  ],
  [
   60.798,
   64.435,
   "入れられる仕事は、\n読む人のいない比較表のような\nものだ。"
  ],
  [
   64.615,
   69.67,
   "速くなる工夫をしたのも、\n空いた時間を埋める仕事を\n引き受けたのも、俺だ。"
  ],
  [
   69.93,
   73.606,
   "俺が作った時間は、\n会社の次の仕事に使われる。"
  ],
  [
   74.076,
   77.885,
   "ビルを出ると、夜風が、\n首筋の汗を冷やした。"
  ],
  [
   78.065,
   81.816,
   "駅へ歩く途中、\n知らない女の香水の\n匂いがした。"
  ]
