 "subs": [
  [
   0.18,
   4.113,
   "自分の匂いが気になったのは、\n今夜の広告を見てからだった。"
  ],
  [
   4.413,
   9.889,
   "木曜の二十一時四十分。\n帰りの電車で、\n俺は吊り革につかまっている。"
  ],
  [
   10.049,
   15.788,
   "目の前の中吊りに、\n大きく書いてある。\n「その匂い、周りはもう\n気づいています」"
  ],
  [
   15.908,
   21.162,
   "襟用の消臭シートの広告だ。\n三十枚入りで、六百八十円。"
  ],
  [
   21.282,
   27.711,
   "俺はそっと、襟に鼻を寄せた。\n洗剤と、夕方の汗の匂いが、\n少しした。"
  ],
  [
   27.831,
   31.17,
   "さっきまで\n気にもしていなかったのに、\nもう気になっている。"
  ],
  [
   31.29,
   37.092,
   "広告は、まず不安を作る。\n気にする人が増えるほど、\n消臭シートは売れるからだ。"
  ],
  [
   37.212,
   42.515,
   "誰が気づいているのかは、\n書いていない。書かなくても、\n客は周りを疑う。"
  ],
  [
   42.635,
   47.799,
   "鞄には、もう二箱ある。\n去年の夏にも、\n同じ広告を見て買った。"
  ],
  [
   47.919,
   52.06,
   "今夜も、駅前の薬局で、\n三箱目を買うつもりだ。"
  ],
  [
   52.18,
   58.071,
   "一日座って働けば、\nシャツは汗をかく。\nその匂いを消す物を、帰りに買う。"
  ],
  [
   58.291,
   63.542,
   "俺は、気にしなくてよかった匂いを、\n匂うほど働いた金で、\n消している。"
  ],
  [
   63.892,
   68.889,
   "隣に、女の人が立った。\n髪から、石けんのような\n匂いがした。"
  ],
  [
   69.009,
   74.665,
   "吊り革の手が、俺の手の隣にある。\n指先の体温が、\n伝わってくる気がした。"
  ],
  [
   74.785,
   78.421,
   "俺は、襟が気になって、\n半歩、離れた。"
  ],
  [
   78.541,
   83.458,
   "離れたのに、石けんの匂いは、\n駅を出ても\n鼻の先に残っていた。"
  ]
 ],
