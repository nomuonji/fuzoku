 "subs": [
  [
   0.18,
   5.265,
   "俺の会社の扇風機が、\n三百九十八円で、\n山になっていた。"
  ],
  [
   5.565,
   10.414,
   "日曜の十六時四十分。\n郊外の量販店の、\n通路の端だ。"
  ],
  [
   10.714,
   15.889,
   "「在庫一掃」の札の下に、\n首にかける扇風機の箱が、\n積んである。"
  ],
  [
   16.069,
   21.847,
   "定価は二千九百八十円。\n去年の夏に出した、\nうちの会社の製品だ。"
  ],
  [
   22.027,
   27.244,
   "いまは十一月だ。\nそれでも客は、安いからと、\n箱をカゴに入れていく。"
  ],
  [
   27.424,
   33.817,
   "俺は会社で、売上の集計をしている。\nこの山がここにある理由も、\n数字で知っている。"
  ],
  [
   33.997,
   38.329,
   "うちの売上は、\n店に納めた日に立つ。\n客が買った日ではない。"
  ],
  [
   38.509,
   45.401,
   "売れ残った分は、店が\n札を貼り替えて、安く売り切る。\n売り切れば、店はまた注文をくれる。"
  ],
  [
   45.581,
   53.859,
   "買った客の家では、扇風機は\n来年の夏まで、押し入れに\nしまわれたままになる。\n使われなくても、売上は売上だ。"
  ],
  [
   54.039,
   56.843,
   "その売上から、\n俺の給料が出ている。"
  ],
  [
   57.103,
   61.305,
   "俺の給料は、\n誰かがいらないのに買った物で、\nできている。"
  ],
  [
   61.775,
   69.496,
   "俺は、一番上の箱の札が\n見えるように、向きを直した。\nそれから、自分でも一台、\nカゴに入れた。"
  ],
  [
   69.676,
   71.498,
   "家には、もう二台ある。"
  ],
  [
   71.678,
   75.589,
   "レジを待つ間、\nカゴの箱が、\n手の甲に冷たかった。"
  ],
  [
   75.769,
   80.184,
   "前に並んでいた\n女の人の、コートから、\n石けんの匂いがした。"
  ],
  [
   80.364,
   83.639,
   "外に出ると、\n駐車場は、もう暗かった。"
  ]
 ],
